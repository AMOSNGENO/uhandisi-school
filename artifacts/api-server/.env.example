# Copy to .env and fill in. .env is ignored by git — never commit real keys.

PORT=8090
DATABASE_URL=mysql://root@localhost:3306/uhandisi_school

# Optional: first admin account (only used when no admin exists yet).
# If ADMIN_PASSWORD is empty a random one is generated and printed once in the server log.
ADMIN_EMAIL=admin@uhandisi.school
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# M-Pesa (Safaricom Daraja, "M-Pesa Express" / STK push)
# Leave these empty and payments are recorded as pending for an admin to confirm by hand.
# Get sandbox keys at https://developer.safaricom.co.ke (create an app with M-Pesa Express).
# ---------------------------------------------------------------------------

# sandbox or production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Paybill (or Head Office) number. Sandbox test shortcode: 174379
MPESA_SHORTCODE=
# Lipa Na M-Pesa Online passkey. The sandbox passkey is shown on the Daraja test credentials page.
MPESA_PASSKEY=

# CustomerPayBillOnline for a Paybill, CustomerBuyGoodsOnline for a Till number.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Only for CustomerBuyGoodsOnline: the till number customers pay to.
MPESA_TILL_NUMBER=

# Public HTTPS address Safaricom will call with each result. It must reach this server's
# /api/mpesa/callback — on your PC use a tunnel such as ngrok: https://<id>.ngrok-free.app/api/mpesa/callback
MPESA_CALLBACK_URL=
# Long random string. It's added to the callback URL so nobody else can mark payments as paid.
MPESA_CALLBACK_SECRET=
